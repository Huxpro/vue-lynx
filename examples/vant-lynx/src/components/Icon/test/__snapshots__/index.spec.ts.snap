// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Icon > should render icon with builtin icon name correctly 1`] = `"<view vue-ref-2="1" is="i" class="van-icon van-icon-success van-icon"><text vue-ref-5="1"></text></view>"`;

exports[`Icon > should render icon with local image correctly 1`] = `"<view vue-ref-2="1" is="i" class="van-icon van-icon"><image vue-ref-6="1" src="/assets/icon.jpg" class="van-icon__image"></image></view>"`;

exports[`Icon > should render icon with url name correctly 1`] = `"<view vue-ref-2="1" is="i" class="van-icon van-icon"><image vue-ref-6="1" src="https://example.com/icon.png" class="van-icon__image"></image></view>"`;
